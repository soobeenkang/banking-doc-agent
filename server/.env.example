# 서버를 로컬(uvicorn)에서 실행할 때의 DB 주소
# docker compose로 서버를 띄우면 이 값은 무시
DATABASE_URL=postgresql://app:app@localhost:5432/banking_doc

# 워크플로우 1 (서류 판정) Studio Agent — Studio "API로 이용하기" 화면에서 확인
WORKFLOW1_AGENT_ID=agt_xxxxxxxxxxxx
WORKFLOW1_CONFIG_ID=1

# iM4 폴더 위치 (기본값: server 옆의 ../iM4). Upstage API 키는 iM4/.env 에서 읽힘
# IM4_DIR=../iM4

# React 개발 서버 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
